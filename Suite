package hotel;
public class Suite extends Habitacion {
    private static final double RECARGO = 0.15;

    public Suite(int il_numero) {
        super(il_numero, "Suite", 150.0);
    }

    @Override
    public double calcularCosto(int il_dias) {
        return il_dias * getDg_precio() * (1 + RECARGO);
    }

    @Override
    public String getDescripcion() {
        return "Suite con servicios adicionales (recargo 15%)";
    }
}
